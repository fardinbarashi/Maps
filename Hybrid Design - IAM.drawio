        <mxCell id="FPqMHxv_qP33vrG37nPg-102" parent="1" style="image;aspect=fixed;perimeter=ellipsePerimeter;html=1;align=center;shadow=0;dashed=0;spacingTop=3;image=img/lib/active_directory/windows_server_2.svg;" value="Certificate Server" vertex="1">
